// Prisma schema for LPPM UNUSU (Lembaga Penelitian dan Pengabdian kepada Masyarakat)
// Mengelola Riset Dosen, Pengabdian (PKM), Publikasi Jurnal & HKI

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Penelitian {
  id              Int               @id @default(autoincrement())
  judul           String            @db.Text
  ketua           String            // Nama Dosen Ketua Peneliti
  nidn            String            @db.VarChar(50)
  anggota         String?           @db.Text
  bidangFokus     String            // AI, Teknologi Informasi, Pendidikan, Aswaja
  danaDisetujui   Decimal?          @db.Decimal(12, 2)
  sumberDana      String            @default("Internal UNUSU") // Kemendikbud, Internal, Mandiri
  tahun           Int               @default(2026)
  status          String            @default("Disetujui") // Pengajuan, Review, Disetujui, Selesai
  laporanUrl      String?
  monevRecords    MonitoringEvaluasi[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // --- Index kinerja query daftar/filter (lihat docs/database/INDEX_STRATEGY.md) ---
  @@index([createdAt])            // GET /api/penelitian -> ORDER BY createdAt DESC
  @@index([tahun, status])        // filter tahun + status sekaligus
  @@index([bidangFokus])          // filter bidang fokus
  @@index([nidn])                 // pencarian usulan milik dosen tertentu
  @@map("lppm_penelitian")
}

model Pengabdian {
  id              Int               @id @default(autoincrement())
  judul           String            @db.Text
  ketua           String
  nidn            String            @db.VarChar(50)
  anggota         String?           @db.Text
  mitra           String            // SMK NU, Pesantren, UMKM Binaan
  lokasi          String            // Medan, Deli Serdang, dsb.
  danaDisetujui   Decimal?          @db.Decimal(12, 2)
  tahun           Int               @default(2026)
  status          String            @default("Disetujui")
  monevRecords    MonitoringEvaluasi[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // --- Index kinerja query daftar/filter (lihat docs/database/INDEX_STRATEGY.md) ---
  @@index([createdAt])            // GET /api/pengabdian -> ORDER BY createdAt DESC
  @@index([tahun, status])        // filter tahun + status sekaligus
  @@index([mitra])                // filter/rekap per mitra
  @@index([nidn])                 // pencarian kegiatan milik dosen tertentu
  @@map("lppm_pengabdian")
}

model Publikasi {
  id          Int      @id @default(autoincrement())
  judul       String   @db.Text
  penulis     String
  jenis       String   @default("Jurnal Nasional") // Jurnal Internasional (Scopus), Jurnal Nasional (SINTA), Prosiding, Buku
  namaJurnal  String
  volumeIssue String?  // Vol. 4 No. 2
  tahun       Int      @default(2026)
  doiUrl      String?
  sintaScore  String?  @default("SINTA 3")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Index kinerja query daftar/filter (lihat docs/database/INDEX_STRATEGY.md) ---
  @@index([tahun])          // GET /api/publikasi -> ORDER BY tahun DESC
  @@index([jenis, tahun])   // filter jenis publikasi per tahun
  @@index([penulis])        // pencarian riwayat publikasi penulis
  @@map("lppm_publikasi")
}

model Role {
  id          Int              @id @default(autoincrement())
  kode        String           @unique @db.VarChar(50) // misal: SUPERADMIN, ADMIN_LPPM, DOSEN, REVIEWER
  nama        String           @db.VarChar(100)
  deskripsi   String?          @db.Text
  permissions RolePermission[]
  userRoles   UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("lppm_roles")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  username  String   @db.VarChar(100) // NIM / NIDN / username civitas dari SSO
  nama      String   @db.VarChar(150)
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([username, roleId])
  @@index([username])
  @@index([roleId])
  @@map("lppm_user_roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  kode        String           @unique @db.VarChar(100) // misal: penelitian.view, penelitian.create
  nama        String           @db.VarChar(150)
  modul       String           @db.VarChar(50) // Penelitian, Pengabdian, Publikasi, Manajemen Pengguna, Sistem
  deskripsi   String?          @db.Text
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([modul])   // GET /api/permissions -> ORDER BY modul, kode
  @@map("lppm_permissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("lppm_role_permissions")
}


enum JenisProgramMonev {
  PENELITIAN
  PENGABDIAN
}

enum TahapMonev {
  MONEV_ANTARA    // Monev Tengah / Kemajuan (Kemajuan 50-70%)
  MONEV_AKHIR     // Monev Akhir / Pasca Pelaksanaan
  MONEV_LAPANGAN  // Monev Visitasi Lapangan Langsung
}

enum StatusMonev {
  DIJADWALKAN     // Baru dijadwalkan reviewer/admin
  SEDANG_DITELAAH // Penelaahan berkas & capaian
  PERLU_REVISI    // Terdapat catatan perbaikan target luaran
  DISETUJUI       // Hasil telaah memenuhi syarat kelayakan
  DITOLAK         // Tidak memenuhi syarat kelayakan luaran
}

enum RekomendasiMonev {
  LANJUT_PENUH    // Pencairan termin lanjutan 100%
  LANJUT_BERSYARAT// Pencairan dengan revisi/perbaikan luaran
  TUNDA           // Penundaan dana termin hingga perbaikan selesai
  HENTIKAN        // Penghentian pendanaan karena wanprestasi
}

model MonitoringEvaluasi {
  id               Int                @id @default(autoincrement())
  kodeMonev        String             @unique @db.VarChar(50) // misal: MNV-PEN-2026-001
  jenisProgram     JenisProgramMonev  // PENELITIAN / PENGABDIAN
  tahap            TahapMonev         @default(MONEV_ANTARA)
  status           StatusMonev        @default(DIJADWALKAN)
  rekomendasi      RekomendasiMonev?  @default(LANJUT_PENUH)
  
  // Relasi Polimorfik ke Penelitian atau Pengabdian
  penelitianId     Int?
  penelitian       Penelitian?        @relation(fields: [penelitianId], references: [id], onDelete: Cascade)
  pengabdianId     Int?
  pengabdian       Pengabdian?        @relation(fields: [pengabdianId], references: [id], onDelete: Cascade)

  // Aspek Monev & Reviewer
  namaReviewer     String             @db.VarChar(150)
  nidnReviewer     String?            @db.VarChar(50)
  tanggalJadwal    DateTime           @db.Date
  tanggalMonev     DateTime?          @db.Date
  lokasiMonev      String?            @db.VarChar(255) // Daring Zoom / Ruang Sidang LPPM / Lapangan Desa Mitra

  // Indikator Kemajuan Tridharma (Skala / Persentase)
  persentaseKemajuan Int              @default(0) // 0 - 100%
  persentaseDanaTerpakai Int          @default(0) // 0 - 100%
  skorSubstansi    Decimal?           @db.Decimal(5, 2) // Skor nilai review misal: 87.50
  
  // Capaian Target & Catatan Evaluasi
  targetLuaranWajib   String?         @db.Text // Artikel Jurnal, Prosiding, Buku Ajar, Video, Mitra UMKM
  capaianLuaran       String?         @db.Text // Draft submitted, LoA, Prototype, dsb.
  catatanReviewer     String?         @db.Text
  tindakLanjut        String?         @db.Text
  beritaAcaraUrl      String?         @db.VarChar(255)
  buktiDokumentasiUrl String?         @db.VarChar(255)

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([penelitianId])
  @@index([pengabdianId])
  @@index([jenisProgram, status])
  @@index([tahap])
  // --- Index tambahan untuk pagination & penjadwalan monev ---
  @@index([createdAt])          // GET /api/monev -> ORDER BY createdAt DESC + skip/take
  @@index([tanggalJadwal])      // kalender/agenda monev terdekat
  @@index([nidnReviewer])       // riwayat penugasan reviewer
  @@map("lppm_monitoring_evaluasi")
}

// ==========================================
// Audit Trail (jejak mutasi data)
// ==========================================
// Tabel append-only: hanya INSERT dari middleware, tanpa UPDATE/DELETE.
// Tidak memakai foreign key ke tabel entitas agar log tetap utuh (immutable)
// walaupun record sumbernya dihapus.

enum AksiAudit {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id         Int       @id @default(autoincrement())
  aktorId    Int?      // id user SSO (ONE UNUSU)
  aktorNidn  String?   @db.VarChar(50)
  aktorNama  String?   @db.VarChar(150)
  aktorRole  String?   @db.VarChar(50)
  aksi       AksiAudit
  entitas    String    @db.VarChar(50)  // penelitian | pengabdian | publikasi | monev | role | permission
  entitasId  Int?      // id record yang dimutasi (null untuk koleksi)
  metode     String    @db.VarChar(10)  // POST | PUT | PATCH | DELETE
  path       String    @db.VarChar(255)
  statusCode Int
  ringkasan  String?   @db.Text         // ringkasan payload (dipotong, tanpa data sensitif)
  ipAddress  String?   @db.VarChar(64)
  createdAt  DateTime  @default(now())

  @@index([createdAt])            // daftar log terbaru (ORDER BY createdAt DESC, id DESC)
  @@index([entitas, entitasId])   // riwayat satu record
  @@index([aktorNidn])            // aktivitas satu dosen/admin
  @@index([aksi, createdAt])      // rekap CREATE/UPDATE/DELETE per periode
  @@map("lppm_audit_log")
}

model LppmBannerSlider {
  id              Int      @id @default(autoincrement())
  judul           String   @db.VarChar(150)
  subjudul        String?  @db.VarChar(255)
  gambarUrl       String   @db.LongText
  gambarMobileUrl String?  @db.LongText
  linkUrl         String?  @db.VarChar(255)
  urutan          Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active, urutan])
  @@map("lppm_banner_sliders")
}




